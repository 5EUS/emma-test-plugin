{
  "id": "emma.plugin.test",
  "name": "EMMA Test Plugin",
  "version": "0.1.38",
  "description": "Local test plugin that provides paged content via gRPC.",
  "author": "projectemma",
  "protocol": "grpc",
  "runtime": {
    "minHostVersion": "1.0.0"
  },
  "mediaTypes": [
    "paged"
  ],
  "thumbnail": {
    "aspectRatio": 0.7,
    "fit": "cover",
    "width": 256,
    "height": 384
  },
  "searchExperience": {
    "capabilities": [
      "landing-v1",
      "filters-v1",
      "query-additions-v1"
    ],
    "landing": {
      "template": "media-search",
      "title": "MangaDex Search",
      "subtitle": "Discover manga by title, tags, author, demographic, and maturity",
      "sections": [
        {
          "id": "hero",
          "type": "hero",
          "title": "Search MangaDex",
          "description": "Use query and optional filters. Works with simple query too.",
          "mediaTypes": [
            "paged"
          ],
          "actions": [
            {
              "id": "quick-naruto",
              "label": "Naruto",
              "type": "set-query",
              "value": "naruto"
            },
            {
              "id": "quick-one-piece",
              "label": "One Piece",
              "type": "set-query",
              "value": "one piece"
            }
          ]
        }
      ]
    },
    "filters": [
      {
        "id": "core.tags",
        "label": "Include Tags",
        "type": "multi",
        "appliesToMediaTypes": [
          "paged"
        ],
        "description": "Search MangaDex tags by name.",
        "lookup": {
          "minQueryLength": 1,
          "maxResults": 20,
          "debounceMs": 250,
          "allowCustomValues": true
        }
      },
      {
        "id": "core.tags.exclude",
        "label": "Exclude Tags",
        "type": "multi",
        "appliesToMediaTypes": [
          "paged"
        ],
        "description": "Search MangaDex tags by name.",
        "lookup": {
          "minQueryLength": 1,
          "maxResults": 20,
          "debounceMs": 250,
          "allowCustomValues": true
        }
      },
      {
        "id": "core.author",
        "label": "Author",
        "type": "multi",
        "appliesToMediaTypes": [
          "paged"
        ],
        "description": "Search MangaDex authors by name.",
        "lookup": {
          "minQueryLength": 1,
          "maxResults": 10,
          "debounceMs": 250,
          "allowCustomValues": true
        }
      },
      {
        "id": "core.artist",
        "label": "Artist",
        "type": "multi",
        "appliesToMediaTypes": [
          "paged"
        ],
        "description": "Search MangaDex artists by name.",
        "lookup": {
          "minQueryLength": 1,
          "maxResults": 10,
          "debounceMs": 250,
          "allowCustomValues": true
        }
      },
      {
        "id": "core.demographic",
        "label": "Demographic",
        "type": "multi",
        "appliesToMediaTypes": [
          "paged"
        ],
        "options": [
          {
            "value": "shounen",
            "label": "Shounen"
          },
          {
            "value": "shoujo",
            "label": "Shoujo"
          },
          {
            "value": "josei",
            "label": "Josei"
          },
          {
            "value": "seinen",
            "label": "Seinen"
          }
        ]
      },
      {
        "id": "core.status",
        "label": "Status",
        "type": "multi",
        "appliesToMediaTypes": [
          "paged"
        ],
        "options": [
          {
            "value": "ongoing",
            "label": "Ongoing"
          },
          {
            "value": "completed",
            "label": "Completed"
          },
          {
            "value": "hiatus",
            "label": "Hiatus"
          },
          {
            "value": "cancelled",
            "label": "Cancelled"
          }
        ]
      },
      {
        "id": "core.maturity",
        "label": "Maturity",
        "type": "multi",
        "appliesToMediaTypes": [
          "paged"
        ],
        "defaultValues": [
          "safe",
          "suggestive"
        ],
        "options": [
          {
            "value": "safe",
            "label": "Safe",
            "isDefault": true
          },
          {
            "value": "suggestive",
            "label": "Suggestive",
            "isDefault": true
          },
          {
            "value": "erotica",
            "label": "Erotica"
          },
          {
            "value": "pornographic",
            "label": "Pornographic"
          }
        ]
      }
    ],
    "query": {
      "allowFreeText": true,
      "minLength": 1,
      "maxLength": 200,
      "additions": [
        {
          "id": "core.language",
          "label": "Translated Language",
          "type": "single",
          "defaultValue": "en",
          "options": [
            {
              "value": "en",
              "label": "English",
              "isDefault": true
            },
            {
              "value": "ja",
              "label": "Japanese"
            },
            {
              "value": "ko",
              "label": "Korean"
            },
            {
              "value": "zh",
              "label": "Chinese"
            }
          ],
          "appliesToMediaTypes": [
            "paged"
          ]
        },
        {
          "id": "core.originalLanguage",
          "label": "Original Language",
          "type": "single",
          "placeholder": "e.g. ja",
          "appliesToMediaTypes": [
            "paged"
          ]
        },
        {
          "id": "core.year",
          "label": "Year",
          "type": "number",
          "placeholder": "e.g. 2020",
          "appliesToMediaTypes": [
            "paged"
          ]
        },
        {
          "id": "core.tags.mode",
          "label": "Included Tag Mode",
          "type": "single",
          "defaultValue": "and",
          "options": [
            {
              "value": "and",
              "label": "AND",
              "isDefault": true
            },
            {
              "value": "or",
              "label": "OR"
            }
          ],
          "appliesToMediaTypes": [
            "paged"
          ]
        },
        {
          "id": "core.tags.exclude.mode",
          "label": "Excluded Tag Mode",
          "type": "single",
          "defaultValue": "or",
          "options": [
            {
              "value": "or",
              "label": "OR",
              "isDefault": true
            },
            {
              "value": "and",
              "label": "AND"
            }
          ],
          "appliesToMediaTypes": [
            "paged"
          ]
        }
      ]
    }
  },
  "preferences": {
    "version": 1,
    "categories": [
      {
        "id": "connection",
        "label": "Connection",
        "description": "Provider identity, authentication, and endpoint settings."
      },
      {
        "id": "search",
        "label": "Search Defaults",
        "description": "Saved defaults applied when browsing and searching."
      },
      {
        "id": "advanced",
        "label": "Advanced",
        "description": "Diagnostics and low-level request behavior for plugin validation."
      }
    ],
    "fields": [
      {
        "key": "connection.username",
        "label": "Account Name",
        "type": "string",
        "category": "connection",
        "description": "Optional account identifier used by future authenticated requests.",
        "placeholder": "reader@example.com",
        "maxLength": 120,
        "helpText": "Stored as a normal string value in the host database."
      },
      {
        "key": "connection.apiToken",
        "label": "API Token",
        "type": "secret",
        "category": "connection",
        "description": "Protected secret used to validate secure plugin-managed settings.",
        "required": true,
        "placeholder": "Paste a token",
        "secret": {
          "protection": "protected",
          "revealInUi": false,
          "allowCopy": false
        },
        "helpText": "Phase 1 uses host-managed protected storage for this value."
      },
      {
        "key": "search.defaultLanguage",
        "label": "Default Language",
        "type": "enum",
        "category": "search",
        "description": "Preferred translated language for query additions.",
        "defaultValue": "en",
        "options": [
          {
            "value": "en",
            "label": "English",
            "isDefault": true
          },
          {
            "value": "ja",
            "label": "Japanese"
          },
          {
            "value": "ko",
            "label": "Korean"
          },
          {
            "value": "zh",
            "label": "Chinese"
          }
        ]
      },
      {
        "key": "search.defaultMaturity",
        "label": "Visible Maturity Ratings",
        "type": "multienum",
        "category": "search",
        "description": "Saved default maturity selections for test searches.",
        "defaultValue": [
          "safe",
          "suggestive"
        ],
        "options": [
          {
            "value": "safe",
            "label": "Safe",
            "isDefault": true
          },
          {
            "value": "suggestive",
            "label": "Suggestive",
            "isDefault": true
          },
          {
            "value": "erotica",
            "label": "Erotica"
          },
          {
            "value": "pornographic",
            "label": "Pornographic"
          }
        ]
      },
      {
        "key": "advanced.enableVerboseLogging",
        "label": "Verbose Logging",
        "type": "boolean",
        "category": "advanced",
        "description": "Turns on extra debug output for provider request experiments.",
        "defaultValue": false
      },
      {
        "key": "advanced.requestTimeout",
        "label": "Request Timeout",
        "type": "duration",
        "category": "advanced",
        "description": "Per-request timeout in TimeSpan format.",
        "defaultValue": "00:00:15",
        "placeholder": "00:00:15",
        "visibleWhen": {
          "field": "advanced.enableVerboseLogging",
          "equalsValue": true
        },
        "helpText": "Shown only when verbose logging is enabled so visibility rules can be exercised."
      }
    ]
  },
  "capabilities": {
    "network": [
      "https"
    ],
    "fileSystem": [],
    "cache": false,
    "cpuBudgetMs": 250,
    "memoryMb": 512
  },
  "permissions": {
    "domains": [
      "api.mangadex.org",
      "uploads.mangadex.org"
    ],
    "paths": []
  }
}
